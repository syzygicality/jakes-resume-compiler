FROM debian:trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        texlive-latex-base \
        wget \
        perl \
        xz-utils \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN tlmgr init-usertree \
    && tlmgr option repository https://ftp.tu-chemnitz.de/pub/tug/historic/systems/texlive/2025/tlnet-final \
    && tlmgr install \
        titlesec \
        hyperref \
        enumitem \
        fancyhdr \
        preprint \
        marvosym \
        fontawesome \
        graphics \
        tools \
        babel \
        amsmath \
    && rm -rf /root/texmf/web2c/*.log

# pdftex is a non-relocatable package (tlmgr refuses it in user-tree mode).
# We only need the one generic .tex file from it (glyphtounicode.tex),
# the binary itself already comes from apt's texlive-binaries.
RUN wget -O /tmp/pdftex.tar.xz \
        https://ftp.tu-chemnitz.de/pub/tug/historic/systems/texlive/2025/tlnet-final/archive/pdftex.tar.xz \
    && mkdir -p /tmp/pdftex-extract \
    && tar -xJf /tmp/pdftex.tar.xz -C /tmp/pdftex-extract \
    && TEXMFLOCAL=$(kpsewhich -var-value TEXMFLOCAL) \
    && mkdir -p "$TEXMFLOCAL/tex/generic/pdftex" \
    && cp /tmp/pdftex-extract/texmf-dist/tex/generic/pdftex/glyphtounicode.tex \
        "$TEXMFLOCAL/tex/generic/pdftex/" \
    && mktexlsr \
    && rm -rf